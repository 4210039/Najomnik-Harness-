# ---------------------------------------------------------------------------
# NajomApp environment
#
# Copy to `.env.local` and fill in. NEVER commit `.env.local`.
#
# Where to find these: Supabase dashboard -> Project Settings -> API.
#   VITE_SUPABASE_URL      = "Project URL"
#   VITE_SUPABASE_ANON_KEY = the anon / "publishable" key
#
# NEVER put the service_role / secret key in a VITE_ variable. Vite inlines
# every VITE_* value into the public bundle, and the secret key bypasses Row
# Level Security — it would be readable by every visitor to the site.
#
# Leave BOTH values blank and the app reports itself as unconfigured:
# `isSupabaseConfigured` is false and `getSupabase()` throws a descriptive
# error rather than failing obscurely. That is the state tests and local UI
# work run in until the project keys are filled in here.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=

# Supabase anon/public key (safe to expose to the browser; RLS enforces access)
VITE_SUPABASE_ANON_KEY=
