# ---------------------------------------------------------------------------
# NajomApp environment
#
# Copy to `.env.local` and fill in. NEVER commit `.env.local`.
#
# Leave BOTH values blank to run against the in-memory mock adapter, which is
# what happens automatically during tests and local UI work before the
# Supabase project exists (Sprint 1.2).
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=

# Supabase anon/public key (safe to expose to the browser; RLS enforces access)
VITE_SUPABASE_ANON_KEY=
